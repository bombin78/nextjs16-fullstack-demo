// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String?
  password String

  builds Build[]
  likes Like[]

  createdAt DateTime @default(now())
}

model Component {
  id String @id @default(cuid())
  type ComponentType
  name String
  price Int

  socket String?

  buildComponents BuildComponent[]
}

model Build {
  id String @id @default(cuid())
  name String
  totalPrice Int @default(0)

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  components BuildComponent[]

  isPublic Boolean @default(false)

  likes Like[]

  createdAt DateTime @default(now())
}

model BuildComponent {
  id String @id @default(cuid())
  buildId String
  build Build @relation(fields: [buildId], references: [id], onDelete: Cascade)
  
  componentId String
  component Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([buildId, componentId])
}

model Like {
  id String @id @default(cuid())

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  buildId String
  build Build @relation(fields: [buildId], references: [id], onDelete: Cascade)

  @@unique([userId, buildId])
}

// enum ComponentType — enum языка схемы Prisma, а не TypeScript enum.
// Это список значений, которые может принять поле type в model Component
// выше. Каждая строка ниже — одно значение. Значение пишут одним словом:
// cpu, без кавычек и без двоеточия.
// TypeScript-код не может импортировать этот файл. Поэтому команда
// prisma generate делает из enum файл lib/generated/prisma/enums.ts.
// Там каждое значение становится парой:
//   export const ComponentType = {
//     cpu: 'cpu',
//     gpu: 'gpu',
//     ...
//   } as const;
// В паре cpu: 'cpu' обе части одинаковые. @map меняет только значение
// в базе: из cpu @map("processor") в базе было бы 'processor', а в enums.ts
// осталось бы cpu: 'cpu'.
// Раз enums.ts сделан из этого файла, после изменения enum в этом файле
// снова запускают prisma generate.
enum ComponentType {
  cpu
  gpu
  ram
  ssd
  motherboard
  psu
  case
  cooler
}
