{
  "permissions": {
    "deny": [
      "Read(//)",
      "Write(//)",
      "Edit(//)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git restore *)",
      "Bash(git reset *)",
      "Bash(git push *)",
      "Edit(.git/**)"
    ],
    "allow": [
      "Read(.)",
      "Read(./**)",
      "Write(.)",
      "Write(./**)",
      "Edit(.)",
      "Edit(./**)",
      "WebSearch",
      "WebFetch"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowRead": [
        "."
      ],
      "allowWrite": [
        "."
      ],
      "denyRead": [
        "~/"
      ],
      "denyWrite": [
        "~/",
        ".git"
      ]
    }
  }
}
